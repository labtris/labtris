# Copied to /etc/labtris/labtris.env by the installer. These are the settings
# that were being passed by hand on every restart.
LABTRIS_DATABASE_URL=postgresql+asyncpg://labtris:labtris@localhost:5432/labtris
LABTRIS_NETD_SOCKET=/run/labtris/netd.sock
LABTRIS_QEMU_ACCEL=kvm
# Unrestricted arguments to a process on this host. Leave off unless you
# understand that it is equivalent to shell access.
LABTRIS_QEMU_ALLOW_EXTRA_ARGS=false
